PORT=5001
DATABASE_URL=postgresql://user:password@host:5432/claimoptiq
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
UPLOAD_PATH=./uploads

# Frontend base URL — used to build password-reset links in emails, and where
# the Google Drive connect flow sends the browser back to (/backup).
FRONTEND_URL=http://localhost:3000

# SMTP for transactional email (password reset).
# If SMTP_HOST/SMTP_USER/SMTP_PASS are blank, reset links are logged to the
# server console instead of emailed (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ClaimOptiq <no-reply@claimoptiq.com>

# Backup credential encryption (64 hex chars). Encrypts SFTP passwords/keys and
# Google Drive tokens. Losing or changing it makes stored credentials unusable.
BACKUP_ENCRYPTION_KEY=

# Google Drive backup (optional). OAuth "Web application" client from Google
# Cloud Console with the Drive API enabled. The redirect URI must be registered
# on that client exactly as written here. Leave blank to hide Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/backup/gdrive/callback
